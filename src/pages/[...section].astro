---
import Analytics from '@vercel/analytics/astro';
import Card from '../components/Card.astro';
import Customize from '../components/Customize.astro';
import { PAGE_CACHE_CONTROL } from '../lib/config';
import { loadDashboard } from '../lib/dashboard';
import { parseForm, parseParams, toQuery } from '../lib/params';
import { clockUtc } from '../lib/time';
import { CARD_LAYOUT, PRIMARY_SECTION, SECTION_BY_SLUG, sectionPath, SECTIONS, SORT_OPTIONS, SOURCE_BY_ID, TRENDING_ID } from '../sources';
import '../styles/global.css';

const params = Astro.url.searchParams;

// "/" is the primary section; every other section has its own path.
const slug = Astro.params.section;
const section = slug === undefined ? PRIMARY_SECTION : SECTION_BY_SLUG.get(slug);
if (!section) return new Response('Not found', { status: 404 });
if (slug === PRIMARY_SECTION.slug) return Astro.redirect(`/${Astro.url.search}`, 301);
const path = sectionPath(section);

// The Customize form submits raw fields; turn them into a clean, canonical URL.
if (params.has('edit')) {
  const q = toQuery(parseForm(params, CARD_LAYOUT, SORT_OPTIONS, section.slug), CARD_LAYOUT);
  return Astro.redirect(q ? `${path}?${q}` : path, 303);
}

const cfg = parseParams(params, CARD_LAYOUT, SORT_OPTIONS, section.slug);
const query = toQuery(cfg, CARD_LAYOUT);
const cards = await loadDashboard(cfg);

Astro.response.headers.set('Cache-Control', PAGE_CACHE_CONTROL);

const codeOf = (id: string) => (id === TRENDING_ID ? '★ TRENDING' : (SOURCE_BY_ID.get(id)?.code ?? id));
const nameOf = (id: string) => (id === TRENDING_ID ? 'Trending' : (SOURCE_BY_ID.get(id)?.name ?? id));

// Page-level freshness: the most recent successful fetch of any card on the page.
// Cards that couldn't be refreshed show their own older time in red.
const times = cards
  .map((c) => (c.kind === 'trending' ? c.fetchedAt : c.result.fetchedAt))
  .filter((t): t is number => t !== undefined);
const latest = times.length ? Math.max(...times) : undefined;
---

<!doctype html>
<html lang="en" data-theme={cfg.theme === 'auto' ? undefined : cfg.theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{section.title}</title>
    <meta name="description" content={section.description} />
    {
      cfg.theme === 'auto' ? (
        <>
          <meta name="color-scheme" content="light dark" />
          <meta name="theme-color" content="#eef0f3" media="(prefers-color-scheme: light)" />
          <meta name="theme-color" content="#0d0f12" media="(prefers-color-scheme: dark)" />
        </>
      ) : (
        <>
          <meta name="color-scheme" content={cfg.theme} />
          <meta name="theme-color" content={cfg.theme === 'light' ? '#eef0f3' : '#0d0f12'} />
        </>
      )
    }
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <script src="/copy-link.js" defer is:inline></script>
    <script src="/local-time.js" defer is:inline></script>
    {
      /*
       * Vercel Web Analytics (@vercel/analytics): cookieless, and the script
       * and beacon are served from this domain, so the CSP's 'self' rules
       * cover them. Production builds only; the endpoints exist only on Vercel.
       */
      import.meta.env.PROD && <Analytics />
    }
  </head>
  <body>
    <header class="top">
      <h1><a href="/">scott-feed<span class="caret" aria-hidden="true">_</span></a></h1>
      {
        SECTIONS.length > 1 && (
          <nav aria-label="Sections" class="sections">
            {SECTIONS.map((s) => (
              <a href={query ? `${sectionPath(s)}?${query}` : sectionPath(s)} aria-current={s === section ? 'page' : undefined}>{s.name}</a>
            ))}
          </nav>
        )
      }
      <nav aria-label="Jump to card" class="chips">
        {cards.map((c) => <a href={`#${c.id}`} aria-label={nameOf(c.id)}>{codeOf(c.id)}</a>)}
      </nav>
      <div class="status">
        {
          latest && (
            <span>
              updated <time datetime={new Date(latest).toISOString()} data-clock title="Most recent successful fetch">{clockUtc(latest)}</time>
            </span>
          )
        }
        <span>window: {cfg.window}</span>
      </div>
      <Customize cfg={cfg} />
    </header>
    <main class="cards">
      {cards.map((card) => <Card card={card} />)}
    </main>
    <footer>
      {section.sources.length} sources · no cookies · anonymous page-view stats only ·
      <a href="https://github.com/scottackerson/scott-feed" target="_blank" rel="noopener noreferrer">github</a>
    </footer>
  </body>
</html>
