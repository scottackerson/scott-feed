---
import Card from '../components/Card.astro';
import Customize from '../components/Customize.astro';
import { PAGE_CACHE_CONTROL } from '../lib/config';
import { loadDashboard } from '../lib/dashboard';
import { parseForm, parseParams, toQuery } from '../lib/params';
import { ALL_CARDS, SOURCE_BY_ID, TRENDING_ID } from '../sources';
import '../styles/global.css';

const params = Astro.url.searchParams;

// The Customize form submits raw fields; turn them into a clean, canonical URL.
if (params.has('edit')) {
  const q = toQuery(parseForm(params, ALL_CARDS), ALL_CARDS);
  return Astro.redirect(q ? `/?${q}` : '/', 303);
}

const cfg = parseParams(params, ALL_CARDS);
const cards = await loadDashboard(cfg);

Astro.response.headers.set('Cache-Control', PAGE_CACHE_CONTROL);

const nameOf = (id: string) => (id === TRENDING_ID ? 'Trending' : (SOURCE_BY_ID.get(id)?.name ?? id));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>scott-feed: trending tech news</title>
    <meta name="description" content="A fast, stateless dashboard of what's trending in tech." />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f7f7f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#151515" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <script src="/copy-link.js" defer is:inline></script>
  </head>
  <body>
    <header class="top">
      <h1>scott-feed</h1>
      <nav aria-label="Cards" class="chips">
        {cards.map((c) => <a href={`#${c.id}`}>{nameOf(c.id)}</a>)}
      </nav>
    </header>
    <Customize cfg={cfg} />
    <main class="cards">
      {cards.map((card) => <Card card={card} />)}
    </main>
    <footer>
      <a href="https://github.com/scottackerson/scott-feed" target="_blank" rel="noopener noreferrer">Source on GitHub</a>
    </footer>
  </body>
</html>
