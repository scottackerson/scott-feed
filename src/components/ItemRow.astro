---
import { domainOf } from '../lib/normalize-url';
import { relativeAge } from '../lib/time';
import type { Item, Spectrum } from '../lib/types';
import { SOURCE_BY_ID } from '../sources';

interface Props {
  item: Item;
  rank: number;
  /** For Trending: every source this story appeared on. */
  appearances?: Item[];
  scoreLabel?: string;
  /** For Trending: why the story is placed here, and who is covering it. */
  why?: string;
  spectrum?: Spectrum;
}

const { item, rank, appearances, scoreLabel = 'pts', why, spectrum } = Astro.props;
const spectrumLabel = spectrum && { both: 'left + right', left: 'left only', right: 'right only' }[spectrum];
const domain = domainOf(item.url);
const age = SOURCE_BY_ID.get(item.source)?.undated ? '' : relativeAge(item.publishedAt);
const plural = (n: number, word: string) => `${n.toLocaleString('en-US')} ${word}${n === 1 ? '' : 's'}`;
---

<li class="item">
  <span class="rank" aria-hidden="true">{String(rank).padStart(2, '0')}</span>
  <div class="body">
    <a class="title" href={item.url} target="_blank" rel="noopener noreferrer" title={item.title}>
      {item.title}<span class="sr-only"> (opens in new tab)</span>
    </a>
    <div class="meta">
      {domain && <span>{domain}</span>}
      {age && <time datetime={item.publishedAt} data-age>{age}</time>}
      {
        appearances ? (
          <span class="badges">
            {appearances.map((a) => {
              const src = SOURCE_BY_ID.get(a.source);
              const code = src?.code ?? a.source;
              return a.discussionUrl ? (
                <a class="badge" href={a.discussionUrl} target="_blank" rel="noopener noreferrer" title={`Discussion on ${src?.name}`}>
                  [{code}]<span class="sr-only"> {src?.name} discussion (opens in new tab)</span>
                </a>
              ) : (
                <span class="badge" title={src?.name}>[{code}]</span>
              );
            })}
          </span>
        ) : (
          <>
            {item.score !== undefined && <span>{item.score.toLocaleString('en-US')} {scoreLabel}</span>}
            {item.discussionUrl && (
              <a href={item.discussionUrl} target="_blank" rel="noopener noreferrer">
                {item.comments !== undefined ? plural(item.comments, 'comment') : 'discuss'}
                <span class="sr-only"> (opens in new tab)</span>
              </a>
            )}
          </>
        )
      }
      {spectrumLabel && <span class="spectrum">{spectrumLabel}</span>}
      {
        why && (
          <details class="why">
            <summary>why<span class="sr-only"> this story is here</span></summary>
            <span>{why}</span>
          </details>
        )
      }
    </div>
  </div>
</li>
