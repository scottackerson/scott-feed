---
import { TRENDING_SORT_DESCRIPTION } from '../lib/config';
import type { CardData } from '../lib/dashboard';
import { clockUtc } from '../lib/time';
import ItemRow from './ItemRow.astro';

interface Props {
  card: CardData;
}

const { card } = Astro.props;
const isTrending = card.kind === 'trending';
const name = isTrending ? 'Trending' : card.result.source.name;
const homepage = isTrending ? undefined : card.result.source.homepage;
const about = isTrending ? undefined : card.result.source.about;
const sortDescription = isTrending ? TRENDING_SORT_DESCRIPTION : card.result.source.sortDescription;
const fetchedAt = isTrending ? card.fetchedAt : card.result.fetchedAt;
const status = isTrending ? 'ok' : card.result.status;
const staleNames = card.kind === 'trending' ? card.staleSources.map((s) => s.name) : [];
const isStale = status === 'stale' || staleNames.length > 0;
const list = (names: string[]) => names.join(', ').replace(/, ([^,]*)$/, ' and $1');
const headingId = `h-${card.id}`;
---

<section class:list={['card', { hot: isTrending, stale: isStale }]} id={card.id} aria-labelledby={headingId}>
  <header>
    <h2 id={headingId}>
      {homepage ? <a href={homepage} target="_blank" rel="noopener noreferrer">{name}</a> : name}
    </h2>
    <details class="info">
      <summary title={about ? `About ${name} and how this card is sorted` : 'How this card is sorted'}>
        <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
          <circle cx="8" cy="8" r="7" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
          <rect x="7.25" y="7" width="1.5" height="5" rx=".75" fill="currentColor"></rect>
          <circle cx="8" cy="4.75" r="1" fill="currentColor"></circle>
        </svg>
        <span class="sr-only">{about ? `About ${name} and how it is sorted` : `How ${name} is sorted`}</span>
      </summary>
      <div class="info-panel">
        {about && <p><strong>About {name}:</strong> {about}</p>}
        <p><strong>How this card is sorted:</strong> {sortDescription}</p>
      </div>
    </details>
    {
      fetchedAt && (
        <time
          datetime={new Date(fetchedAt).toISOString()}
          data-clock
          title={isStale ? 'Not current: when this data was last fetched successfully' : "When this card's data was fetched"}
        >
          {clockUtc(fetchedAt)}
        </time>
      )
    }
  </header>

  {
    status === 'stale' && (
      <p class="notice stale-notice" role="status">
        Couldn't reach {name}. Showing the last data we got, from the time above.
      </p>
    )
  }
  {
    staleNames.length > 0 && (
      <p class="notice stale-notice" role="status">
        Couldn't reach {list(staleNames)}. {staleNames.length === 1 ? 'Its' : 'Their'} stories are from an earlier fetch.
      </p>
    )
  }

  {
    card.items.length ? (
      <ol>
        {card.kind === 'trending'
          ? card.items.map((t, i) => <ItemRow item={t.item} rank={i + 1} appearances={t.appearances} />)
          : card.items.map((it, i) => <ItemRow item={it} rank={i + 1} scoreLabel={card.result.source.scoreLabel} />)}
      </ol>
    ) : (
      <p class="notice">{status === 'error' ? 'Unavailable right now.' : 'Nothing in this time window.'}</p>
    )
  }
</section>
