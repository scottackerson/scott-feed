---
import { MAX_ITEMS, MIN_ITEMS } from '../lib/config';
import { countFor, offSectionFields, THEMES, type ViewConfig } from '../lib/params';
import { WINDOWS } from '../lib/time';
import { CARD_LAYOUT, SECTION_BY_SLUG, sectionPath, SOURCE_BY_ID, TRENDING_ID } from '../sources';

interface Props {
  cfg: ViewConfig;
}

const { cfg } = Astro.props;
// Shown cards first (in their order), then hidden ones.
const sectionCards = CARD_LAYOUT[cfg.section];
const rows = [...cfg.cards, ...sectionCards.filter((id) => !cfg.cards.includes(id))];
const path = sectionPath(SECTION_BY_SLUG.get(cfg.section)!);
const nameOf = (id: string) => (id === TRENDING_ID ? 'Trending' : (SOURCE_BY_ID.get(id)?.name ?? id));
const sortsOf = (id: string) => SOURCE_BY_ID.get(id)?.sorts;
---

<details class="customize">
  <summary>customize</summary>
  <form method="get" action={path} class="panel">
    <input type="hidden" name="edit" value="1" />
    {offSectionFields(cfg, CARD_LAYOUT).map(([name, value]) => <input type="hidden" name={name} value={value} />)}
    <p class="hint">
      Settings live in the URL. After saving, bookmark the page to keep your view. No cookies or storage are used.
    </p>
    <div class="row">
      <label>Items per card <input type="number" name="n" value={cfg.n} min={MIN_ITEMS} max={MAX_ITEMS} /></label>
      <label>
        Time window
        <select name="window">
          {Object.keys(WINDOWS).map((w) => <option value={w} selected={w === cfg.window}>{w}</option>)}
        </select>
      </label>
      <label>
        Theme
        <select name="theme">
          {THEMES.map((t) => <option value={t} selected={t === cfg.theme}>{t === 'auto' ? 'System' : t[0].toUpperCase() + t.slice(1)}</option>)}
        </select>
      </label>
    </div>
    <table>
      <thead>
        <tr><th scope="col">Show</th><th scope="col">Card</th><th scope="col">Order</th><th scope="col">Items</th><th scope="col">Sort</th></tr>
      </thead>
      <tbody>
        {
          rows.map((id, i) => (
            <tr>
              <td>
                <input type="checkbox" name="show" value={id} id={`show-${id}`} checked={cfg.cards.includes(id)} />
              </td>
              <td><label for={`show-${id}`}>{nameOf(id)}</label></td>
              <td>
                <input type="number" name={`o.${id}`} value={i + 1} min="1" max={sectionCards.length} aria-label={`${nameOf(id)} order`} />
              </td>
              <td>
                <input
                  type="number"
                  name={`n.${id}`}
                  value={cfg.perCard[id] ?? ''}
                  placeholder={String(countFor(cfg, id))}
                  min={MIN_ITEMS}
                  max={MAX_ITEMS}
                  aria-label={`${nameOf(id)} items`}
                />
              </td>
              <td>
                {sortsOf(id) ? (
                  <select name={`sort.${id}`} aria-label={`${nameOf(id)} sort order`}>
                    <option value={sortsOf(id)!.default.id}>{sortsOf(id)!.default.label}</option>
                    {sortsOf(id)!.others.map((m) => (
                      <option value={m.id} selected={cfg.sort[id] === m.id}>{m.label}</option>
                    ))}
                  </select>
                ) : (
                  <span class="none" aria-hidden="true">—</span>
                )}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
    <div class="row">
      <button type="submit">Save view</button>
      <a href={path}>Reset to defaults</a>
      <button type="button" id="copy-link" hidden>Copy link</button>
    </div>
  </form>
</details>
